{
  "name": "github-paste-plugin",
  "displayName": "GitHub Paste Plugin",
  "publisher": "local-user",
  "repository": {
    "type": "git",
    "url": "https://github.com/local-user/github-paste-plugin"
  },
  "description": "Custom paste image, video, audio, or file to GitHub",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.70.0"
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.70.0",
    "@vscode/vsce": "^2.15.0"
  },
  "activationEvents": [
    "onCommand:extension.pasteImageToGitHub"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.pasteImageToGitHub",
        "title": "Paste Image/File to GitHub"
      }
    ],
    "keybindings": [
      {
        "command": "extension.pasteImageToGitHub",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "GitHub Paste Plugin",
      "properties": {
        "githubPastePlugin.token": {
          "type": "string",
          "description": "GitHub Personal Access Token"
        },
        "githubPastePlugin.repo": {
          "type": "string",
          "description": "GitHub Repository (e.g. username/repo)"
        }
      }
    }
  }
}